# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ncsam-pledge?retryWrites=true&w=majority

# Frontend Allowed Origin (CORS)
FRONTEND_URL=http://localhost:5173,https://ncsampledge.vercel.app

# SMTP Email Configuration for Certificate Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Naksh Foundation <no-reply@naksh.org>"

# Configurable Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=150
RATE_LIMIT_PLEDGE_MAX=20
