# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ncsam-pledge?retryWrites=true&w=majority

# Frontend Allowed Origin (CORS)
FRONTEND_URL=http://localhost:5173

# Public verification domain for QR code payload
PUBLIC_BASE_URL=https://naksh.org

# SMTP Email Configuration for Certificate Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Naksh Foundation <no-reply@naksh.org>"
